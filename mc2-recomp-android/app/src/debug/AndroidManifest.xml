<?xml version="1.0" encoding="utf-8"?>
<!--
  Solo en builds de depuración: permite lanzar las pantallas desde adb
  (am start -d file:///...) para pruebas de humo del runtime nativo.
  En release las actividades siguen siendo privadas.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <activity
            android:name=".GameActivity"
            android:exported="true"
            tools:node="merge"
            tools:replace="android:exported" />
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            tools:node="merge"
            tools:replace="android:exported" />
    </application>

</manifest>
